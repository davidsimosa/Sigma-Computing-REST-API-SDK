{
  "name": "sigma-computing-rest-api-sdk",
  "version": "0.1.0",
  "sigmaApiVersion": "2.0.0",
  "description": "TypeScript SDK for the Sigma Computing REST API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "generate:types": "openapi-typescript spec/openapi.json -o src/generated/openapi.d.ts",
    "generate:resources": "tsx scripts/generate-resources.ts",
    "generate": "npm run generate:types && npm run generate:resources && npm run format",
    "build": "npm run sync:spec-version && npm run generate && npm run lint && npm run format:check && npm run typecheck && npm run test && tsup",
    "build:bundle": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync:spec-version": "tsx scripts/sync-spec-version.ts",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidsimosa/Sigma-Computing-REST-API-SDK.git"
  },
  "bugs": {
    "url": "https://github.com/davidsimosa/Sigma-Computing-REST-API-SDK/issues"
  },
  "homepage": "https://github.com/davidsimosa/Sigma-Computing-REST-API-SDK#readme",
  "keywords": [
    "sigma",
    "sigma-computing",
    "sdk",
    "api",
    "typescript",
    "rest",
    "openapi"
  ],
  "author": "David Simosa",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.6.0",
    "prettier": "^3.9.6",
    "tsup": "^8.4.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.7"
  }
}
